{$SITE_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy web:8080
}

# Optional extra sites (for example a test copy). Put a *.caddy file in deploy/vps/caddy-extra/ on the server;
# it is not tracked by git. With no files there, nothing changes.
import /etc/caddy/extra/*.caddy
