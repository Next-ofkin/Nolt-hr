    "/api/v1/forms": {
      "get": {
        "operationId": "FormsController_list",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "Required for mutations; obtained from the authenticated session",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FormDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "HR forms"
        ]
      },
      "post": {
        "operationId": "FormsController_create",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "Required for mutations; obtained from the authenticated session",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "recipient": {
                    "default": "EMPLOYEE",
                    "type": "string",
                    "enum": [
                      "EMPLOYEE",
                      "GUARANTOR",
                      "REFERENCE"
                    ]
                  }
                },
                "required": [
                  "title",
                  "recipient"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "HR forms"
        ]
      }
    },
    "/api/v1/form-versions/{id}": {
      "get": {
        "operationId": "FormsController_get",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "Required for mutations; obtained from the authenticated session",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "HR forms"
        ]
      },
      "put": {
        "operationId": "FormsController_save",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "Required for mutations; obtained from the authenticated session",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true,
                    "maximum": 9007199254740991
                  },
                  "content": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "description": {
                        "default": "",
                        "type": "string",
                        "maxLength": 2000
                      },
                      "recipient": {
                        "type": "string",
                        "enum": [
                          "EMPLOYEE",
                          "GUARANTOR",
                          "REFERENCE"
                        ]
                      },
                      "fields": {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "text",
                                "textarea",
                                "email",
                                "phone",
                                "number",
                                "date",
                                "select",
                                "checkbox",
                                "file",
                                "signature"
                              ]
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "helpText": {
                              "default": "",
                              "type": "string",
                              "maxLength": 1000
                            },
                            "required": {
                              "type": "boolean"
                            },
                            "options": {
                              "default": [],
                              "maxItems": 50,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              }
                            },
                            "signatureMethod": {
                              "default": "EITHER",
                              "type": "string",
                              "enum": [
                                "DRAW",
                                "UPLOAD",
                                "EITHER"
                              ]
                            },
                            "attachmentPurpose": {
                              "default": "SUPPORTING_DOCUMENT",
                              "type": "string",
                              "enum": [
                                "SUPPORTING_DOCUMENT",
                                "SIGNED_DOCUMENT"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "type",
                            "label",
                            "helpText",
                            "required",
                            "options",
                            "signatureMethod",
                            "attachmentPurpose"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "title",
                      "description",
                      "recipient",
                      "fields"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "expectedRevision",
                  "content"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "HR forms"
        ]
      }
    },
    "/api/v1/form-versions/{id}/publish": {
      "post": {
        "operationId": "FormsController_publish",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "Required for mutations; obtained from the authenticated session",
