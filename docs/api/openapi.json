                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "expectedRevision"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "HR forms"
        ]
      }
    },
    "/api/v1/forms/{id}/versions": {
      "post": {
        "operationId": "FormsController_newVersion",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "Required for mutations; obtained from the authenticated session",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "HR forms"
        ]
      }
    }
  },
  "info": {
    "title": "NOLT HR API",
    "description": "Initial HR form authoring slice. Local identity is development-only.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nolt_session"
      }
    },
    "schemas": {
      "SessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "csrfToken"
        ]
      },
      "FormDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "formId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "recipient": {
            "type": "string",
            "enum": [
              "EMPLOYEE",
              "GUARANTOR",
              "REFERENCE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ]
          },
          "version": {
            "type": "number"
          },
          "revision": {
            "type": "number"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "updatedAt": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "formId",
          "title",
          "description",
          "recipient",
          "status",
          "version",
          "revision",
          "fields",
          "updatedAt",
          "publishedAt"
        ]
      }
    }
  }
}
