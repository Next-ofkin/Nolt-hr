# NOLT HR API (NestJS) for Google Cloud Run. Build from the repo root.
FROM node:24-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages ./packages
RUN npm ci
COPY apps/api ./apps/api
COPY apps/web ./apps/web
COPY database ./database
COPY scripts ./scripts
# Prisma only needs a placeholder URL to generate its client at build time.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm run db:generate \
 && npm run contracts:build \
 && npm run build -w @nolt/api
ENV NODE_ENV=production
EXPOSE 8080
CMD ["node", "apps/api/dist/main.js"]
