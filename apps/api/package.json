{
  "name": "@nolt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n types,server \"tsc --watch --preserveWatchOutput\" \"node --watch --watch-path=dist dist/main.js\"",
    "build": "tsc && node ../../scripts/copy-api-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "predev": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "^12.0.0",
    "@nolt/form-schemas": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.117.3",
    "dotenv": "^17.3.0",
    "openid-client": "^6.8.8",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.3.0"
  }
}
