generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  role String
  active Boolean @default(true)
  authVersion Int @default(1)
  permissions String[] @default([])
  identities Identity[]
  emailSessions ExternalEmailSession[]
  sessions Session[]
  employee Employee?
  assignedReviews AssignmentReviewAccess[] @relation("ReviewAssignee")
  grantedReviews AssignmentReviewAccess[] @relation("ReviewGrantor")
  reviewDecisions SubmissionReview[] @relation("ReviewActor")
  uploadedFiles StoredFile[]
  externalContacts ExternalContactDraft[]
  externalRequestsCreated ExternalRequest[] @relation("ExternalCreator")
  externalRequestsAnswered ExternalRequest[] @relation("ExternalRespondent")
  externalSubmissions ExternalSubmission[]
  externalRequestsUpdated ExternalRequest[] @relation("ExternalUpdater")
  signatures SignatureEvidence[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  csrfHash String
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  authVersion Int @default(1)
  authMethod String @default("LOCAL")
  mfaVerified Boolean @default(false)
  providerSession String?
  externalRequestId String? @db.Uuid
  externalRequest ExternalRequest? @relation(fields:[externalRequestId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  @@index([externalRequestId])
  @@index([userId])
  @@index([expiresAt])
}
model AuthFlow {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  csrfHash String
  kind String
  encryptedState String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([expiresAt])
}
model Identity {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  issuer String
  subject String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([issuer,subject])
  @@index([userId])
}
model OidcAttempt {
  id String @id @default(uuid()) @db.Uuid
  stateHash String @unique
  browserHash String
  verifier String?
  nonce String
  returnTo String @default("/")
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  @@index([expiresAt])
}
model Form {
  id String @id @default(uuid()) @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  versions FormVersion[]
  assignments FormAssignment[]
  @@index([createdAt])
}
model FormVersion {
  id String @id @default(uuid()) @db.Uuid
  formId String @db.Uuid
  form Form @relation(fields:[formId],references:[id],onDelete:Restrict)
  version Int
  revision Int @default(1)
  status String @default("DRAFT")
  title String
  description String @default("")
  recipient String
  fields Json @default("[]")
  publishedAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  assignments FormAssignment[]
  @@unique([id,formId])
  @@unique([formId,version])
  @@index([status,updatedAt])
}
model Employee {
  id String @id @default(uuid()) @db.Uuid
  userId String? @unique @db.Uuid
  user User? @relation(fields:[userId],references:[id],onDelete:Restrict)
  employeeNumber String? @unique
  fullName String
  email String @unique
  jobTitle String
  department String
  employmentType String
  startDate DateTime @db.Date
  revision Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  cases OnboardingCase[]
  invitations EmployeeInvitation[]
  @@index([department,startDate])
  @@index([createdAt,id])
}
model OnboardingCase {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  status String @default("ACTIVE")
  stage String @default("PRE_ONBOARDING")
  revision Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  assignments FormAssignment[]
  @@index([employeeId,createdAt])
}
model FormAssignment {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  onboardingCase OnboardingCase @relation(fields:[caseId],references:[id],onDelete:Restrict)
  formId String @db.Uuid
  form Form @relation(fields:[formId],references:[id],onDelete:Restrict)
  formVersionId String @db.Uuid
  formVersion FormVersion @relation(fields:[formVersionId,formId],references:[id,formId],onDelete:Restrict)
  required Boolean @default(true)
  dueDate DateTime? @db.Date
  assignedBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  response EmployeeResponse?
  reviewAccess AssignmentReviewAccess?
  submissions FormSubmission[]
  files StoredFile[]
  signatures SignatureEvidence[]
  @@unique([id,formVersionId])
  externalContact ExternalContactDraft?
  externalRequests ExternalRequest[]
  @@unique([caseId,formId])
  @@index([formVersionId,formId])
  @@index([formId])
}
model ExternalContactDraft {
  assignmentId String @id @db.Uuid
  assignment FormAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  fullName String @db.VarChar(160)
  email String @db.VarChar(254)
  revision Int @default(1)
  updatedBy String @db.Uuid
  updater User @relation(fields:[updatedBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  @@index([updatedBy])
}
model ExternalRequest {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  assignment FormAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  requestKey String @db.Uuid
  requestHash String
  contactRevision Int
  fullName String @db.VarChar(160)
  email String @db.VarChar(254)
  createdBy String @db.Uuid
  creator User @relation("ExternalCreator",fields:[createdBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  updatedBy String @db.Uuid
  updater User @relation("ExternalUpdater",fields:[updatedBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  respondentId String? @db.Uuid
  respondent User? @relation("ExternalRespondent",fields:[respondentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  state String @default("QUEUED")
  revision Int @default(0)
  answers Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  submittedAt DateTime? @db.Timestamptz(3)
  delivery ExternalDelivery?
  submission ExternalSubmission?
  emailSessions ExternalEmailSession[]
  sessions Session[]
  @@unique([assignmentId,requestKey])
  @@index([assignmentId,createdAt])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([respondentId])
}
model ExternalDelivery {
  requestId String @id @db.Uuid
  request ExternalRequest @relation(fields:[requestId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  state String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil DateTime? @db.Timestamptz(3)
  errorCode String?
  @@index([state,availableAt])
}
model ExternalSubmission {
  requestId String @id @db.Uuid
  request ExternalRequest @relation(fields:[requestId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  sourceRevision Int
  requestKey String @db.Uuid
  answers Json
  submittedBy String @db.Uuid
  submitter User @relation(fields:[submittedBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  submittedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([submittedBy])
}
model AssignmentReviewAccess {
  assignmentId String @id @db.Uuid
  assignment FormAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  reviewerId String @db.Uuid
  reviewer User @relation("ReviewAssignee",fields:[reviewerId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  sensitivity String
  grantedBy String @db.Uuid
  grantor User @relation("ReviewGrantor",fields:[grantedBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([reviewerId,createdAt])
  @@index([grantedBy])
}
model EmployeeResponse {
  assignmentId String @id @db.Uuid
  assignment FormAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  revision Int @default(1)
  status String @default("DRAFT")
  answers Json @default("{}")
  updatedBy String @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}
model FormSubmission {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  formVersionId String @db.Uuid
  assignment FormAssignment @relation(fields:[assignmentId,formVersionId],references:[id,formVersionId],onDelete:Restrict,onUpdate:NoAction)
  version Int
  sourceRevision Int
  requestKey String @db.Uuid
  answers Json
  submittedBy String @db.Uuid
  submittedAt DateTime @default(now()) @db.Timestamptz(3)
  review SubmissionReview?
  @@unique([assignmentId,version])
  @@unique([assignmentId,requestKey])
}
model SubmissionReview {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @unique @db.Uuid
  submission FormSubmission @relation(fields:[submissionId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  decision String
  reason String?
  reviewedBy String @db.Uuid
  reviewer User @relation("ReviewActor",fields:[reviewedBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  reviewedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([reviewedBy,reviewedAt])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  action String
  targetId String @db.Uuid
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([targetId,createdAt])
}
model HrInvitation {
  id String @id @default(uuid()) @db.Uuid
  email String
  name String
  state String @default("DRAFT")
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([createdAt,id])
}

model EmployeeInvitation {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  requestKey String @db.Uuid
  requestHash String
  state String @default("QUEUED")
  requiresPassword Boolean
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  acceptedBy String? @db.Uuid
  delivery InvitationDelivery?
  @@unique([employeeId,requestKey])
  @@index([employeeId,createdAt])
}
model InvitationDelivery {
  id String @id @default(uuid()) @db.Uuid
  invitationId String @unique @db.Uuid
  invitation EmployeeInvitation @relation(fields:[invitationId],references:[id],onDelete:Restrict)
  outboxId String @unique @db.Uuid
  outbox OutboxEvent @relation(fields:[outboxId],references:[id],onDelete:Restrict)
  state String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil DateTime? @db.Timestamptz(3)
  errorCode String?
  @@index([state,availableAt])
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  type String
  targetId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  invitationDelivery InvitationDelivery?
  @@index([processedAt,createdAt])
}

model StoredFile {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  assignment FormAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  fieldId String @db.Uuid
  uploadedBy String @db.Uuid
  uploader User @relation(fields:[uploadedBy],references:[id],onDelete:Restrict,onUpdate:NoAction)
  purpose String
  bucket String @default("nolt-private-documents")
  storageKey String @unique
  fileName String
  mimeType String
  byteSize Int
  sha256 String
  scanStatus String @default("QUARANTINED")
  scanReason String?
  status String @default("PENDING")
  requestKey String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  signature SignatureEvidence?
  @@unique([assignmentId,requestKey])
  @@index([assignmentId,fieldId])
  @@index([uploadedBy,createdAt])
  @@index([status,expiresAt])
}

model SignatureEvidence {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  assignment FormAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  formVersionId String @db.Uuid
  fieldId String @db.Uuid
  signerId String @db.Uuid
  signer User @relation(fields:[signerId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  signerRole String
  signingMethod String
  consentVersion String
  sourceRevision Int
  contentDigest String
  fileId String @unique @db.Uuid
  file StoredFile @relation(fields:[fileId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  signedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([assignmentId,fieldId])
  @@index([signerId,signedAt])
}

model ExternalEmailSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  requestId String @db.Uuid
  request ExternalRequest @relation(fields:[requestId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  authVersion Int
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([requestId])
  @@index([userId])
  @@index([expiresAt])
}
