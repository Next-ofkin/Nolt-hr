# Copy local transport settings to .env; secrets and hosted connection URLs live in ignored .env.supabase.
LOCAL_DEVELOPMENT=true
AUTH_PROVIDER=supabase
API_PORT=4000
API_ORIGIN=http://127.0.0.1:4000
PUBLIC_APP_URL=http://127.0.0.1:3000
# .env.supabase requires SUPABASE_PROJECT_REF, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# DATABASE_URL (restricted role), DIRECT_DATABASE_URL (migration owner), AUTH_ENCRYPTION_KEY.
# Resend SMTP is configured directly in the Supabase Auth dashboard, not in browser code.
# Server-only SUPABASE_SECRET_KEY is also required by the invitation sender.
INVITATION_TTL_MINUTES=60

# Private files require a private nolt-private-documents Supabase Storage bucket.
# ClamAV daemon, reachable only on the trusted network. Missing scanner blocks confirmation.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Simple guarantor/reference invitations use direct Resend (server-only, save in .env.supabase).
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=NOLT HR <verified-sender@your-domain>

# White-label branding (safe public settings, set in Vercel before build).
NEXT_PUBLIC_BRAND_NAME=NOLT
NEXT_PUBLIC_BRAND_TAGLINE=People
NEXT_PUBLIC_PRODUCT_NAME=HR
NEXT_PUBLIC_BRAND_DESCRIPTION=Employee onboarding and HR workspace
NEXT_PUBLIC_BRAND_PRIMARY=#006b5e
# Commit your own PNG/WebP/JPG file into apps/web/public/branding/ first.
# NEXT_PUBLIC_BRAND_LOGO_PATH=/branding/company-logo.png
