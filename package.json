{
  "name": "nolt-hr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/hosted-qa.mjs dev",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "prisma generate --config database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config database/prisma.config.ts",
    "typecheck": "npm run contracts:build && npm run typecheck --workspaces --if-present",
    "build": "npm run contracts:build && npm run build -w @nolt/api && npm run build -w @nolt/web",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:domain": "node scripts/test-onboarding-db.mjs",
    "test:e2e": "playwright test",
    "api:generate": "npm run build -w @nolt/api && node apps/api/dist/export-openapi.js && openapi-typescript docs/api/openapi.json -o packages/api-client/src/schema.d.ts",
    "contracts:build": "npm run build -w @nolt/form-schemas",
    "predev": "npm run contracts:build",
    "db:permissions": "node scripts/db-permissions.mjs",
    "format": "prettier --write apps packages/form-schemas/src packages/api-client/src/index.ts tests scripts database/*.ts package.json tsconfig*.json playwright.config.ts",
    "dev:hosted": "node scripts/hosted-qa.mjs dev",
    "db:hosted:verify": "node scripts/hosted-qa.mjs verify",
    "db:hosted:status": "node scripts/hosted-qa.mjs status",
    "test:hosted": "node scripts/hosted-qa.mjs test",
    "test:e2e:hosted": "node scripts/hosted-qa.mjs e2e",
    "predev:hosted": "npm run contracts:build",
    "db:hosted:migrate": "node scripts/hosted-qa.mjs migrate",
    "auth:setup": "node scripts/hosted-qa.mjs setup",
    "worker:hosted": "node scripts/hosted-qa.mjs worker",
    "scanner:start": "powershell -NoProfile -File scripts/clamav-local.ps1 start",
    "scanner:stop": "powershell -NoProfile -File scripts/clamav-local.ps1 stop",
    "scanner:update": "powershell -NoProfile -File scripts/clamav-local.ps1 update",
    "scanner:status": "powershell -NoProfile -File scripts/clamav-local.ps1 status",
    "scanner:test": "node scripts/test-clamav.mjs",
    "build:api": "npm run db:generate && npm run contracts:build && npm run build -w @nolt/api",
    "start:api": "node apps/api/dist/main.js",
    "build:web": "npm run contracts:build && npm run build -w @nolt/web",
    "start:web": "npm run start:railway -w @nolt/web",
    "auth:hr:preflight": "node scripts/hr-activation-preflight.mjs",
    "auth:hr:provider-check": "node scripts/hr-provider-readonly-check.mjs",
    "auth:hr:provider-interactive": "node scripts/hr-provider-interactive-check.mjs",
    "auth:hr:sandbox-enroll": "node scripts/hr-provider-sandbox-enroll.mjs",
    "auth:hr:activate": "node scripts/hr-activation-runner.mjs",
    "auth:developer:preflight": "node scripts/developer-bootstrap.mjs",
    "auth:developer:apply": "node scripts/developer-bootstrap.mjs --apply"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "express": "^5.3.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
